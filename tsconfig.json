{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "vite/client",
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true
    },
    "include": [
        "src",
        "scripts",
        "vite.config.ts"
    ]
}
